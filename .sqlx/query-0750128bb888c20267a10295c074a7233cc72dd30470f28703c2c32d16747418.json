  "query": "SELECT record_id, space_id, subject_id, kind, content_json, scope_visibility, scope_context_id, provenance_json, import_ref_json, occurred_at, tombstone_json, revision, created_at, updated_at FROM memory_records WHERE space_id = ? AND subject_id = ? AND (? OR tombstone_json IS NULL) AND (json_array_length(?) = 0 OR kind IN (SELECT value FROM json_each(?))) AND (? OR (? AND scope_visibility = 'shared') OR scope_context_id IN (SELECT value FROM json_each(?))) AND (? OR EXISTS (SELECT 1 FROM json_each(json_extract(provenance_json, '$.source_context_ids')) AS source JOIN json_each(?) AS f ON f.value = source.value)) ORDER BY created_at DESC, record_id",
