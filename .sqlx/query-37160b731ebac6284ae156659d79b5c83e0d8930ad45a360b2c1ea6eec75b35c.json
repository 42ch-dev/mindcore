  "query": "SELECT candidate_id, space_id, subject_id, capture_visibility, capture_context_id, kind, content_json, provenance_json, classification_json, status, consumed_by_json, content_digest, occurred_at, expires_at, revision, created_at FROM memory_candidates WHERE space_id = ? AND subject_id = ? AND (? OR (? AND capture_visibility = 'shared') OR capture_context_id IN (SELECT value FROM json_each(?))) AND (? IS NULL OR status = ?) ORDER BY created_at, candidate_id",
