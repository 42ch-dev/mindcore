  "cards": [
    {
      "dot": "cyan",
      "title": "Memory",
      "items": [
        "capture stages a pending candidate; review projects records or none",
        "recall reads live records only and pages by a byte or item budget",
        "an idempotency key replays the recorded outcome, never the effect"
      ]
    },
    {
      "dot": "emerald",
      "title": "Knowledge",
      "items": [
        "a port is bound to one collection when it is built",
        "expected_base_revision makes every update compare-and-swap",
        "adoption anchors resolve the source retirement chain before the write"
      ]
    },
    {
      "dot": "amber",
      "title": "Cognition",
      "items": [
        "append-only records under one carrier entry",
        "MindState is derived from the carrier, never stored twice",
        "every record is validated at the single persistence boundary"
      ]
    }
  ]
